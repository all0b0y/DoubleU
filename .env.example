# LLM configuration for local Docker Compose.
# Copy these values into .env and replace the API key.
MOCK_LLM=false
OPENROUTER_API_KEY=

# Default model path for requests without a role or when a tier is empty.
OPENROUTER_MODEL=deepseek/deepseek-v3.2
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-v4-flash

# Global constant model for the tool orchestrator. Empty falls back to MODEL_CHEAP.
MODEL_ROUTER=deepseek/deepseek-v4-flash
TWO_STAGE_DRAFT=false

# Per-role model lists. The first model is primary; the rest are fallbacks.
# After changing model values, run `make models-apply` to synchronize LiteLLM
# and the AI service. LiteLLM's concrete model_list is generated automatically.
MODEL_TIER_FAST=deepseek/deepseek-v4-flash,deepseek/deepseek-v3.2
MODEL_TIER_BALANCED=deepseek/deepseek-v3.2,deepseek/deepseek-v4-flash
MODEL_TIER_SMART=deepseek/deepseek-v4-pro,qwen/qwen3.7-max

# Route through the LiteLLM service included in docker-compose.yml.
LLM_GATEWAY=litellm
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MASTER_KEY=sk-doubleu-local-master
